{
  "page_info": {
    "title": "阿里巴巴搜索页面内容提取规则",
    "description": "针对1688.com搜索页面的商品信息提取规则",
    "version": "1.0.0",
    "created_date": "2024-12-30"
  },
  "page_structure": {
    "main_container": {
      "selector": "#app",
      "description": "页面主容器"
    },
    "search_container": {
      "selector": ".space-pc-ui2024",
      "description": "搜索页面容器"
    },
    "search_box": {
      "selector": ".search-common-searchbox",
      "description": "搜索框区域"
    }
  },
  "extraction_rules": {
    "page_metadata": {
      "page_title": {
        "selector": "title",
        "attribute": "text",
        "description": "页面标题"
      },
      "page_url": {
        "selector": "window.location.href",
        "type": "javascript",
        "description": "当前页面URL"
      },
      "search_keyword": {
        "selector": "input[name='keywords'], .search-input input",
        "attribute": "value",
        "description": "搜索关键词"
      }
    },
    "product_list": {
      "container_selector": ".feeds-wrapper",
      "item_selector": ".search-offer-wrapper",
      "fields": {
        "title": {
          "selector": ".offer-title-row .title-text",
          "attribute": "text",
          "fallback_selectors": [".title-text", ".offer-title-row", "[data-title]"],
          "description": "商品标题"
        },
        "price": {
          "selector": ".price-item .text-main",
          "attribute": "text",
          "fallback_selectors": [".text-main", ".price-item", ".col-desc"],
          "description": "商品价格"
        },
        "image": {
          "selector": "img.main-img",
          "fallback_selectors": [".main-img", "img", ".offer-img-wrapper img"],
          "attribute": "src",
          "fallback_attribute": "data-src",
          "description": "商品图片"
        },
        "link": {
          "selector": "a.search-offer-wrapper",
          "attribute": "href",
          "fallback_selectors": ["a[href*='detail.1688.com']"],
          "description": "商品链接"
        },
        "supplier": {
          "selector": ".offer-shop-row .desc-text",
          "attribute": "text",
          "fallback_selectors": [".desc-text", ".offer-shop-row", ".col-left"],
          "description": "供应商名称"
        },
        "location": {
          "selector": ".location, .address, .region",
          "attribute": "text",
          "description": "供应商地址"
        },
        "min_order": {
          "selector": ".offer-tag-row .col-desc .desc-text[style*='color: rgb(255, 64, 0)']",
          "attribute": "text",
          "fallback_selectors": [".offer-tag-row .desc-text", ".col-desc .desc-text"],
          "description": "最小起订量"
        },
        "trade_amount": {
          "selector": ".offer-price-row .col-desc_after .desc-text",
          "attribute": "text",
          "fallback_selectors": [".col-desc_after .desc-text"],
          "description": "成交金额"
        },
        "sales_volume": {
          "selector": ".col-desc_after .offer-desc-item .desc-text",
          "attribute": "text",
          "fallback_selectors": [
            ".col-desc_after .desc-text",
            "span[title*='件']",
            "div:contains('年销量:')",
            "span:contains('件')",
            "div[style*='padding: 3px 0px'] span[title]",
            ".cgzs-button + div span[title]"
          ],
          "description": "销量信息（如：全网2.1万+件）"
        }
      }
    },
    "pagination": {
      "current_page": {
        "selector": ".pagination .current, .page-current",
        "attribute": "text",
        "description": "当前页码"
      },
      "total_pages": {
        "selector": ".pagination .total-page, .page-total",
        "attribute": "text",
        "description": "总页数"
      },
      "next_page_link": {
        "selector": ".pagination .next, .page-next",
        "attribute": "href",
        "description": "下一页链接"
      }
    },
    "filters": {
      "category_filters": {
        "selector": ".category-filter, .cate-filter",
        "description": "分类筛选"
      },
      "price_filters": {
        "selector": ".price-filter",
        "description": "价格筛选"
      },
      "region_filters": {
        "selector": ".region-filter, .area-filter",
        "description": "地区筛选"
      }
    }
  },
  "javascript_variables": {
    "search_data": {
      "variable_names": ["window.searchData", "window.__SEARCH_DATA__", "window.pageData"],
      "description": "页面搜索数据"
    },
    "product_data": {
      "variable_names": ["window.productList", "window.offerList", "window.itemList"],
      "description": "商品列表数据"
    },
    "user_info": {
      "variable_names": ["window.userInfo", "window.loginInfo"],
      "description": "用户信息"
    }
  },
  "data_attributes": {
    "product_id": {
      "attributes": ["data-offer-id", "data-product-id", "data-item-id"],
      "description": "商品ID"
    },
    "supplier_id": {
      "attributes": ["data-supplier-id", "data-company-id", "data-shop-id"],
      "description": "供应商ID"
    },
    "tracking_data": {
      "attributes": ["data-spm", "data-track", "data-log"],
      "description": "埋点追踪数据"
    }
  },
  "extraction_strategy": {
    "priority_order": [
      "javascript_variables",
      "data_attributes", 
      "css_selectors"
    ],
    "fallback_enabled": true,
    "retry_count": 3,
    "wait_for_load": true,
    "load_timeout": 10000
  },
  "validation_rules": {
    "required_fields": ["title", "price", "link"],
    "price_format": "¥?[0-9,.]+(元|万)?",
    "url_validation": "^https?://",
    "min_products_per_page": 10
  },
  "output_format": {
    "format": "json",
    "structure": {
      "page_info": {
        "url": "string",
        "title": "string",
        "search_keyword": "string",
        "timestamp": "string"
      },
      "products": [
        {
          "title": "string",
          "price": "string",
          "image": "string",
          "link": "string",
          "supplier": "string",
          "location": "string",
          "min_order": "string",
          "trade_amount": "string",
          "sales_volume": "string",
          "product_id": "string",
          "supplier_id": "string"
        }
      ],
      "pagination": {
        "current_page": "number",
        "total_pages": "number",
        "next_page_link": "string"
      }
    }
  }
}