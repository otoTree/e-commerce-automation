{
  "short_name": "__MSG_action_title__",
  "name": "__MSG_extension_name__",
  "description": "__MSG_extension_description__",
  "default_locale": "zh_CN",
  "manifest_version": 3,
  "version": "1.1.2",
  "background": {
    "service_worker": "static/js/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "static/js/content.js"
      ]
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "contextMenus",
    "scripting",
    "tabs",
    "cookies",
    "tts",
    "alarms",
    "nativeMessaging"
  ],
  "options_page": "options.html",
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "*.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "static/css/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "prompts.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "static/media/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "commands_modal": {
      "suggested_key": {
        "default": "Alt+K"
      },
      "description": "快捷弹窗"
    },
    "web_translate": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "网页翻译"
    },
    "summary_page": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "页面总结"
    },
    "advanced_select": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "多链接总结"
    }
  },
  "action": {
    "default_icon": {
      "16": "logo-round128.png",
      "32": "logo-round128.png",
      "48": "logo-round128.png",
      "128": "logo-round256.png"
    },
    "default_title": "__MSG_action_title__"
  },
  "icons": {
    "16": "logo-round128.png",
    "32": "logo-round128.png",
    "48": "logo-round128.png",
    "128": "logo-round256.png"
  }
}